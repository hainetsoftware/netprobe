/* NetProbe Pro Modern Responsive TCSS Stylesheet */

Screen {
    background: $background;
    color: $text;
}

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $text-muted;
}

#hero-bar {
    dock: top;
    height: auto;
    background: $surface;
    padding: 1 2;
    border-bottom: solid $panel;
}

#action-buttons {
    height: auto;
    align: left middle;
}

Button {
    margin-right: 1;
    min-width: 10;
    width: auto;
    height: 3;
    border: none;
}

#btn-full {
    background: $success-darken-1;
    color: #ffffff;
    text-style: bold;
}
#btn-full:hover {
    background: $success;
}

#btn-quick {
    background: $secondary;
    color: #ffffff;
    text-style: bold;
}
#btn-quick:hover {
    background: $primary;
}

#btn-export {
    background: $panel;
    color: $text;
    text-style: bold;
}
#btn-export:hover {
    background: $panel-lighten-1;
}

#btn-theme {
    background: $panel;
    color: $primary;
    text-style: bold;
}
#btn-theme:hover {
    background: $panel-lighten-1;
}

#status-container {
    height: auto;
    margin-top: 1;
}

#status-label {
    color: $text-muted;
    text-style: italic;
    height: auto;
    min-height: 1;
    width: 100%;
    margin-bottom: 0;
}

ProgressBar {
    width: 100%;
    margin-top: 0;
}

TabbedContent {
    height: 1fr;
    min-width: 100%;
    background: $background;
}

ContentSwitcher {
    height: 1fr;
}

Tabs {
    background: $surface;
    border-bottom: solid $panel;
    height: 3;
}

Tabs Underline, Tabs > Underline {
    display: none;
}

#tabs-scroll, #tabs-list-bar, #tabs-list {
    height: 2;
}

Tab, ContentTab {
    height: 2;
    color: $text-muted;
    background: transparent;
    padding: 0 2;
    text-style: bold;
    border-bottom: none;
}

Tab:hover, ContentTab:hover {
    color: $text;
    background: $surface-lighten-1;
    border-bottom: none;
}

Tab.-active, ContentTab.-active {
    height: 2;
    color: $primary;
    background: rgba(56, 189, 248, 0.12);
    text-style: bold;
    border-bottom: tall $primary;
}

Tabs:focus .-active, Tabs:focus Tab.-active, Tabs:focus ContentTab.-active, Tabs > Tab:focus, Tabs > ContentTab:focus {
    height: 2;
    color: $primary;
    background: rgba(56, 189, 248, 0.18);
    text-style: bold;
    border-bottom: tall $primary;
}

TabPane {
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary $surface;
    background: $background;
}

VerticalScroll, .pane-scroll {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
    scrollbar-color: $primary $surface;
}

.card {
    background: $surface;
    border: round $panel;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

.card-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.card-title-amber {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

.card-title-emerald {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
}

.breadcrumb-flow {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.hero-metric-row {
    height: auto;
    margin-bottom: 1;
}

.hero-card {
    background: $surface;
    border: round $panel;
    padding: 1 2;
    margin-right: 1;
    height: auto;
    width: 1fr;
}

.hero-value {
    text-style: bold;
    color: $success;
    margin: 1 0;
}

.hero-value-cyan {
    text-style: bold;
    color: $primary;
    margin: 1 0;
}

.hero-subtitle {
    color: $text-muted;
    text-style: italic;
}

.kv-row {
    height: auto;
    margin: 0 0;
}

.kv-key {
    color: $text-muted;
    width: 36;
}

.kv-val {
    color: $text;
    text-style: bold;
}

.kv-val-green {
    color: $success;
    text-style: bold;
}

.kv-val-cyan {
    color: $primary;
    text-style: bold;
}

.kv-val-amber {
    color: $warning;
    text-style: bold;
}

.kv-val-red {
    color: $error;
    text-style: bold;
}

.badge {
    padding: 0 1;
    text-style: bold;
    margin-right: 1;
}

.badge-green {
    background: $success-darken-1;
    color: #ffffff;
}

.badge-amber {
    background: $warning-darken-1;
    color: #ffffff;
}

.badge-red {
    background: $error-darken-1;
    color: #ffffff;
}

.badge-blue {
    background: $secondary;
    color: #ffffff;
}

DataTable {
    height: auto;
    max-height: 22;
    background: $surface;
    border: round $panel;
    min-width: 100%;
    margin: 1 0;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

DataTable:focus {
    border: solid $primary;
}

.rationale-bullet {
    color: $text;
    margin: 0 0 0 2;
}

#empty-state-card {
    background: $surface;
    border: round $panel;
    padding: 1 2;
    margin: 1 0;
    text-align: center;
    align: center middle;
}

#empty-state-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

#empty-state-subtitle {
    color: $text-muted;
}
