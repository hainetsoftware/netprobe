/* NetProbe Pro Modern Responsive TCSS Stylesheet */

Screen {
    background: #0b0f17;
    color: #f1f5f9;
}

Header {
    background: #131b26;
    color: #38bdf8;
    text-style: bold;
}

Footer {
    background: #131b26;
    color: #94a3b8;
}

#hero-bar {
    dock: top;
    height: auto;
    background: #131b26;
    padding: 1 2;
    border-bottom: solid #202d3d;
}

#action-buttons {
    height: 3;
    align: left middle;
}

Button {
    margin-right: 2;
    min-width: 24;
    height: 3;
    border: none;
}

#btn-full {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}
#btn-full:hover {
    background: #2ea043;
}

#btn-quick {
    background: #2563eb;
    color: #ffffff;
    text-style: bold;
}
#btn-quick:hover {
    background: #3b82f6;
}

#btn-export {
    background: #202d3d;
    color: #f1f5f9;
    text-style: bold;
}
#btn-export:hover {
    background: #2e3e52;
}

#status-container {
    height: auto;
    margin-top: 1;
}

#status-label {
    color: #94a3b8;
    text-style: italic;
    height: 1;
    margin-bottom: 0;
}

ProgressBar {
    width: 100%;
    margin-top: 0;
}

TabbedContent {
    height: 1fr;
    background: #0b0f17;
}

Tabs {
    background: #131b26;
    border-bottom: solid #202d3d;
    height: 3;
}

Tab, ContentTab {
    color: #8b9bb4;
    background: #131b26;
    padding: 0 2;
    text-style: bold;
}

Tab:hover, ContentTab:hover {
    color: #f1f5f9;
    background: #1a2433;
}

Tab.-active, ContentTab.-active {
    color: #ffffff;
    background: #0066cc;
    text-style: bold;
    border-bottom: tall #38bdf8;
}

Tabs > Tab:focus, Tabs > ContentTab:focus {
    color: #ffffff;
    background: #0077ee;
    border-bottom: tall #38bdf8;
}

TabPane {
    padding: 1 2;
    overflow-y: auto;
    overflow-x: auto;
    background: #0b0f17;
}

.pane-scroll {
    height: auto;
    overflow-y: auto;
    overflow-x: auto;
}

.card {
    background: #131b26;
    border: round #202d3d;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

.card-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

.card-title-amber {
    text-style: bold;
    color: #facc15;
    margin-bottom: 1;
}

.card-title-emerald {
    text-style: bold;
    color: #4ade80;
    margin-bottom: 1;
}

.hero-metric-row {
    height: auto;
    margin-bottom: 1;
}

.hero-card {
    background: #131b26;
    border: round #202d3d;
    padding: 1 2;
    margin-right: 1;
    height: auto;
    width: 1fr;
}

.hero-value {
    text-style: bold;
    color: #4ade80;
    margin: 1 0;
}

.hero-value-cyan {
    text-style: bold;
    color: #38bdf8;
    margin: 1 0;
}

.hero-subtitle {
    color: #94a3b8;
    text-style: italic;
}

.kv-row {
    height: auto;
    margin: 0 0;
}

.kv-key {
    color: #94a3b8;
    width: 36;
}

.kv-val {
    color: #f1f5f9;
    text-style: bold;
}

.kv-val-green {
    color: #4ade80;
    text-style: bold;
}

.kv-val-cyan {
    color: #38bdf8;
    text-style: bold;
}

.kv-val-amber {
    color: #facc15;
    text-style: bold;
}

.kv-val-red {
    color: #f87171;
    text-style: bold;
}

.badge {
    padding: 0 1;
    text-style: bold;
    margin-right: 1;
}

.badge-green {
    background: #238636;
    color: #ffffff;
}

.badge-amber {
    background: #9e6a03;
    color: #ffffff;
}

.badge-red {
    background: #da3633;
    color: #ffffff;
}

.badge-blue {
    background: #2563eb;
    color: #ffffff;
}

DataTable {
    height: auto;
    max-height: 22;
    background: #131b26;
    border: solid #202d3d;
    margin: 1 0;
}

DataTable > .datatable--header {
    background: #1a2433;
    color: #38bdf8;
    text-style: bold;
}

DataTable:focus {
    border: solid #38bdf8;
}

.rationale-bullet {
    color: #cbd5e1;
    margin: 0 0 0 2;
}

#empty-state-card {
    background: #131b26;
    border: dashed #202d3d;
    padding: 2 4;
    margin: 2 0;
    text-align: center;
    align: center middle;
}

#empty-state-title {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 1;
}

#empty-state-subtitle {
    color: #94a3b8;
}
