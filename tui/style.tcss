/* NetProbe Pro Modern Responsive TCSS Stylesheet */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

Header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

Footer {
    background: #161b22;
    color: #8b949e;
}

#hero-bar {
    dock: top;
    height: auto;
    background: #161b22;
    padding: 1 2;
    border-bottom: solid #30363d;
}

#action-buttons {
    height: 3;
    align: left middle;
}

Button {
    margin-right: 2;
    min-width: 24;
    height: 3;
    border: none;
}

#btn-full {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}
#btn-full:hover {
    background: #2ea043;
}

#btn-quick {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}
#btn-quick:hover {
    background: #388bfd;
}

#btn-export {
    background: #30363d;
    color: #c9d1d9;
    text-style: bold;
}
#btn-export:hover {
    background: #484f58;
}

#status-container {
    height: auto;
    margin-top: 1;
}

#status-label {
    color: #8b949e;
    text-style: italic;
    height: 1;
    margin-bottom: 0;
}

ProgressBar {
    width: 100%;
    margin-top: 0;
}

TabbedContent {
    height: 1fr;
    background: #0d1117;
}

ContentTab {
    text-style: bold;
    padding: 0 2;
}

ContentTab.-active {
    color: #58a6ff;
    border-bottom: tall #58a6ff;
}

TabPane {
    padding: 1 2;
    overflow-y: auto;
    overflow-x: auto;
    background: #0d1117;
}

.pane-scroll {
    height: auto;
    overflow-y: auto;
    overflow-x: auto;
}

.card {
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin: 1 0;
    height: auto;
}

.card-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

.card-title-amber {
    text-style: bold;
    color: #d29922;
    margin-bottom: 1;
}

.card-title-emerald {
    text-style: bold;
    color: #3fb950;
    margin-bottom: 1;
}

.hero-metric-row {
    height: auto;
    margin-bottom: 1;
}

.hero-card {
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-right: 1;
    height: auto;
    width: 1fr;
}

.hero-value {
    text-style: bold;
    color: #3fb950;
    margin: 1 0;
}

.hero-value-cyan {
    text-style: bold;
    color: #58a6ff;
    margin: 1 0;
}

.hero-subtitle {
    color: #8b949e;
    text-style: italic;
}

.kv-row {
    height: auto;
    margin: 0 0;
}

.kv-key {
    color: #8b949e;
    width: 36;
}

.kv-val {
    color: #e6edf3;
    text-style: bold;
}

.kv-val-green {
    color: #3fb950;
    text-style: bold;
}

.kv-val-cyan {
    color: #58a6ff;
    text-style: bold;
}

.kv-val-amber {
    color: #d29922;
    text-style: bold;
}

.kv-val-red {
    color: #f85149;
    text-style: bold;
}

.badge {
    padding: 0 1;
    text-style: bold;
    margin-right: 1;
}

.badge-green {
    background: #238636;
    color: #ffffff;
}

.badge-amber {
    background: #9e6a03;
    color: #ffffff;
}

.badge-red {
    background: #da3633;
    color: #ffffff;
}

.badge-blue {
    background: #1f6feb;
    color: #ffffff;
}

DataTable {
    height: auto;
    max-height: 22;
    background: #161b22;
    border: solid #30363d;
    margin: 1 0;
}

DataTable > .datatable--header {
    background: #21262d;
    color: #58a6ff;
    text-style: bold;
}

.rationale-bullet {
    color: #c9d1d9;
    margin: 0 0 0 2;
}

#empty-state-card {
    background: #161b22;
    border: dashed #30363d;
    padding: 2 4;
    margin: 2 0;
    text-align: center;
    align: center middle;
}

#empty-state-title {
    color: #58a6ff;
    text-style: bold;
    margin-bottom: 1;
}

#empty-state-subtitle {
    color: #8b949e;
}
